sdk/

# ---- 根级构建残留（CMake 在源码根误生成；本项目「构建产物永不作锚点」）----
# 仅锚定根级，避免误伤将来任何位置的手写 Makefile
/CMakeFiles/
/cmake_install.cmake
/CMakeCache.txt
/Makefile

# ---- 运行时状态（部署脚本生成；非交付物）----
/run/
*.pid

